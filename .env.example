NODE_ENV=development

CLIENT_PORT=5173
ADMIN_PORT=5174

GAME_HTTP_PORT=3100
GAME_WS_PORT=3101
GAME_TICK_MS=66
GAME_SNAPSHOT_MS=80
GAME_BOT_COUNT=90
GAME_BOT_TARGET_ONLINE=80
GAME_WS_MAX_BUFFERED_BYTES=65536
AUTH_HTTP_PORT=3200
AUTH_TOKEN_SECRET=replace-with-a-long-random-value
BLOCKCHAIN_HTTP_PORT=3300

# Leave these empty for same-origin routing:
#   browser -> /ws, /auth, /blockchain -> nginx/Vite proxy -> backend ports.
VITE_GAME_WS_URL=
VITE_GAME_API_URL=
VITE_AUTH_API_URL=
VITE_BLOCKCHAIN_API_URL=
VITE_TON_MANIFEST_URL=

VITE_DEV_GAME_HTTP_TARGET=http://localhost:3100
VITE_DEV_GAME_WS_TARGET=ws://localhost:3101
VITE_DEV_AUTH_TARGET=http://localhost:3200
VITE_DEV_BLOCKCHAIN_TARGET=http://localhost:3300

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mmo
POSTGRES_USER=mmo
POSTGRES_PASSWORD=mmo

REDIS_URL=redis://localhost:6379

TON_NETWORK=testnet
TON_TREASURY_ADDRESS=
LIGHTNING_NODE_URL=
LIGHTNING_MACAROON=
